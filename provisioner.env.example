# Copy this file to provisioner.env (same folder) and fill in your values.
# provisioner.env is read by provisioner.py - keep it out of git / readable
# only by the user that runs the cron job (chmod 600).

ODOO_URL=http://127.0.0.1:8069
ODOO_DB=lgdb_19
# A dedicated Odoo user for this integration is safer than using an admin
# login - give it write access to otm.whatsapp.lead.bot only.
ODOO_USERNAME=whatsapp-provisioner@logicschool.example
# Settings > Users > (this user) > Account Security > New API Key.
# Do NOT use the user's normal login password here.
ODOO_API_KEY=paste-the-generated-api-key-here

# Optional. The folder that CONTAINS otm_whatsapp_group_bot_service,
# otm_whatsapp_lead_bot_<slug> instances, etc. - setup_officer_bot.sh is run
# from here. If left blank, defaults to the parent of this bot_service_update/
# folder (correct for the normal layout: bot_service_update/ sitting directly
# inside the client's addons folder). Only set this if your layout differs.
# ADDONS_DIR=/opt/elysians/otomater-custom-addons
